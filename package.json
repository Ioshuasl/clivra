{
  "name": "saas-odontologico",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @repo/backend --filter @repo/frontend run dev",
    "dev:api": "pnpm --filter @repo/backend dev",
    "dev:worker": "pnpm --filter @repo/backend dev:worker",
    "dev:web": "pnpm --filter @repo/frontend dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "arch:check": "pnpm --filter @repo/backend arch:check",
    "test": "pnpm -r run test",
    "test:rls": "pnpm --filter @repo/backend test:rls",
    "test:kms": "pnpm --filter @repo/backend test:kms",
    "test:clinical-crypto": "pnpm --filter @repo/backend test:clinical-crypto",
    "test:identity": "pnpm --filter @repo/backend test:identity",
    "test:outbox": "pnpm --filter @repo/backend test:outbox",
    "test:public-booking": "pnpm --filter @repo/backend test:public-booking",
    "test:waitlist": "pnpm --filter @repo/backend test:waitlist",
    "test:messaging": "pnpm --filter @repo/backend test:messaging",
    "test:messaging-inbox": "pnpm --filter @repo/backend test:messaging-inbox",
    "test:anamnesis": "pnpm --filter @repo/backend test:anamnesis",
    "test:odontogram": "pnpm --filter @repo/backend test:odontogram",
    "test:clinical-notes": "pnpm --filter @repo/backend test:clinical-notes",
    "test:attachments": "pnpm --filter @repo/backend test:attachments",
    "test:split-installments": "pnpm --filter @repo/backend test:split-installments",
    "test:receipt-amount-in-words": "pnpm --filter @repo/backend test:receipt-amount-in-words",
    "test:quotes-crud": "pnpm --filter @repo/backend test:quotes-crud",
    "test:quotes-send": "pnpm --filter @repo/backend test:quotes-send",
    "test:quotes-decision": "pnpm --filter @repo/backend test:quotes-decision",
    "test:treatments-execute": "pnpm --filter @repo/backend test:treatments-execute",
    "test:billing-payments": "pnpm --filter @repo/backend test:billing-payments",
    "test:billing-cash": "pnpm --filter @repo/backend test:billing-cash",
    "test:billing-payables": "pnpm --filter @repo/backend test:billing-payables",
    "test:billing-reports": "pnpm --filter @repo/backend test:billing-reports",
    "test:reporting-dashboard": "pnpm --filter @repo/backend test:reporting-dashboard",
    "test:reporting-export": "pnpm --filter @repo/backend test:reporting-export",
    "test:subscription": "pnpm --filter @repo/backend test:subscription",
    "test:asaas-adapter": "pnpm --filter @repo/backend test:asaas-adapter",
    "test:subscription-checkout": "pnpm --filter @repo/backend test:subscription-checkout",
    "test:asaas-webhook": "pnpm --filter @repo/backend test:asaas-webhook",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "tester": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/skills/tester/scripts/Invoke-Tester.ps1",
    "tester:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/skills/tester/scripts/Invoke-Tester.ps1 -Tunnel",
    "tester:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/skills/tester/scripts/Ensure-Stack.ps1",
    "sprint:board": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/skills/sprint-orchestrator/scripts/Init-SprintBoard.ps1",
    "db:generate": "pnpm --filter @repo/backend db:generate",
    "db:migrate": "pnpm --filter @repo/backend db:migrate",
    "db:seed": "pnpm --filter @repo/backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    }
  }
}
