# App
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3333

# API
PORT=3333
# Worker health (opcional)
# WORKER_HEALTH_PORT=3334
# Runtime: role sem BYPASSRLS (RLS ativa)
DATABASE_URL=postgresql://app_user:app@localhost:5432/odonto_dev?schema=public
# Migrações: superuser local / app_migrator em prod
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/odonto_dev?schema=public
REDIS_URL=redis://localhost:6379

# Auth (dev only — replace in production)
# JWT keys = Base64(PEM PKCS8 / SPKI). Never commit production keys.
JWT_PRIVATE_KEY=<base64-of-pkcs8-pem>
JWT_PUBLIC_KEY=<base64-of-spki-pem>
REFRESH_TOKEN_TTL_DAYS=30

# Storage (MinIO local / S3 prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=odonto-dev
STORAGE_REGION=sa-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# ATTACHMENT_QUOTA_BYTES=1073741824

# Mail (Mailpit local; Resend em produção via RESEND_API_KEY)
MAIL_DSN=smtp://localhost:1025
MAIL_FROM=noreply@localhost

# WhatsApp / WAHA (ADR-0016)
WHATSAPP_APP_SECRET=dev-whatsapp-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# MESSAGING_PROVIDER=waha
WAHA_BASE_URL=https://waha.ioshuavps.com.br
# WAHA_API_KEY=  # só em .env local / VPS — nunca commitar
# WAHA_SESSION_NAME=Ioshua  # sessão WAHA já existente (dev). Ignorado em NODE_ENV=test
# WAHA_HMAC_KEY=
# WAHA_WEBHOOK_URL=http://localhost:3333/api/v1/webhooks/whatsapp
WAHA_ENGINE=WEBJS

# Crypto KEK (local VPS — never commit real key)
# KEK_LOCAL_BASE64=

# Proxies na frente da API (Easypanel = 1). Padrão: 1 em production, 0 fora.
# TRUST_PROXY=1

# Optional
# SENTRY_DSN=
# RESEND_API_KEY=
# DSR_DUE_DAYS=15
# CLINICAL_READ_ANOMALY_N=40
# PLATFORM_OPERATOR_EMAILS=ops@example.com

# Cobrança da assinatura SaaS — Asaas (ADR-0017). `manual` = sem gateway (contingência/kill switch).
BILLING_PROVIDER=manual
# ASAAS_ENV=sandbox                       # sandbox | production
# ASAAS_API_KEY=                          # $aact_hmlg_... (sandbox) | $aact_prod_... (production). Nunca commitar
# ASAAS_WEBHOOK_TOKEN=                    # 32–255 chars, sem espaços, diferente da API key
# ASAAS_USER_AGENT=odonto-saas/1.0
# ASAAS_BASE_URL=                         # só fora de production (túnel/fake)
# ASAAS_CHECKOUT_BASE_URL=                # padrão: https://sandbox.asaas.com | https://asaas.com
