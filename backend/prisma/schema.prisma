generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clínica (tenant). docs/07 §2
model Tenant {
  id              String             @id @db.Uuid
  name            String
  slug            String             @unique @db.Citext
  legalName       String?            @map("legal_name")
  taxId           String?            @map("tax_id")
  responsibleCro  String?            @map("responsible_cro")
  timezone        String             @default("America/Sao_Paulo")
  acceptedPaymentMethods String[]    @default(["CASH", "PIX", "CREDIT_CARD", "DEBIT_CARD"]) @map("accepted_payment_methods")
  onboarding      Json               @default("{\"skippedSteps\":[]}")
  bookingSettings Json               @default("{\"minLeadMinutes\":120,\"maxLeadDays\":60,\"publicStatus\":\"REQUESTED\",\"courtesyTransactionalMessages\":50}") @map("booking_settings")
  /// Agenda por cadeira (visão + cadastro). Default off — clínicas simples usam só profissional.
  chairsEnabled   Boolean            @default(false) @map("chairs_enabled")
  status          String             @default("TRIAL")
  trialEndsAt     DateTime?          @map("trial_ends_at") @db.Timestamptz
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  cryptoKeys      TenantCryptoKey[]
  auditLogs       AuditLog[]
  memberships     Membership[]
  invitations     Invitation[]
  units           Unit[]
  chairs          Chair[]
  professionals   Professional[]
  businessHours   BusinessHours[]
  hoursExceptions BusinessHoursException[]
  procedures      Procedure[]
  patients        Patient[]
  patientCodeCounters PatientCodeCounter[]
  legalGuardians  LegalGuardian[]
  consents        Consent[]
  appointments    Appointment[]
  appointmentHistory AppointmentHistory[]
  appointmentSeries AppointmentSeries[]
  scheduleBlocks  ScheduleBlock[]
  waitlistEntries WaitlistEntry[]
  outboxEvents    OutboxEvent[]
  publicBookingTokens PublicBookingToken[]
  whatsappAccounts WhatsappAccount[]
  messageTemplates MessageTemplate[]
  conversations   Conversation[]
  messages        Message[]
  automations     Automation[]
  automationRuns  AutomationRun[]
  messageCreditLedger MessageCreditLedger[]
  medicalRecords  MedicalRecord[]
  anamnesisForms AnamnesisForm[]
  anamnesisResponses AnamnesisResponse[]
  clinicalAlerts  ClinicalAlert[]
  toothStates     ToothState[]
  toothStateHistories ToothStateHistory[]
  clinicalNotes   ClinicalNote[]
  attachments     Attachment[]
  quoteNumberCounters QuoteNumberCounter[]
  quotes          Quote[]
  quoteItems      QuoteItem[]
  treatmentPlans  TreatmentPlan[]
  treatmentItems  TreatmentItem[]
  financialCategories FinancialCategory[]
  receivables     Receivable[]
  installments    Installment[]
  productionEntries ProductionEntry[]
  receiptNumberCounters ReceiptNumberCounter[]
  payments        Payment[]
  paymentSplits   PaymentSplit[]
  patientCreditLedger PatientCreditLedger[]
  payables        Payable[]
  cashSessions    CashSession[]
  cashMovements   CashMovement[]
  reportExports   ReportExport[]
  subscription    Subscription?
  usageCounters   UsageCounter[]
  dataSubjectRequests DataSubjectRequest[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionCheckouts SubscriptionCheckout[]

  @@map("tenant")
}

/// Plano SaaS global (sem tenant). docs/07 §9 · módulo subscription
model Plan {
  id          String         @id @db.Uuid
  code        String         @unique
  name        String
  priceCents  BigInt         @map("price_cents")
  interval    String         @default("MONTHLY")
  limits      Json
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  subscriptions Subscription[]

  @@map("plan")
}

/// Assinatura da clínica (1:1 tenant). docs/modulos/10-billing-saas.md
model Subscription {
  id                     String    @id @db.Uuid
  tenantId               String    @unique @map("tenant_id") @db.Uuid
  planId                 String    @map("plan_id") @db.Uuid
  status                 String
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz
  externalCustomerId     String?   @map("external_customer_id")
  externalSubscriptionId String?   @map("external_subscription_id")
  cancelAt               DateTime? @map("cancel_at") @db.Timestamptz
  /// PIX | BOLETO | CREDIT_CARD (null = cobrança manual). ADR-0017
  billingMethod          String?   @map("billing_method")
  /// ASAAS | MANUAL. ADR-0017
  billingProvider        String    @default("MANUAL") @map("billing_provider")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  plan                   Plan      @relation(fields: [planId], references: [id])

  @@index([status, trialEndsAt], map: "idx_subscription_status_trial")
  @@map("subscription")
}

/// Espelho local das cobranças geradas pelo Asaas para a assinatura. ADR-0017
model SubscriptionPayment {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  externalPaymentId String    @unique @map("external_payment_id")
  status            String
  valueCents        BigInt    @map("value_cents")
  dueDate           DateTime  @map("due_date") @db.Date
  paidAt            DateTime? @map("paid_at") @db.Timestamptz
  billingType       String?   @map("billing_type")
  invoiceUrl        String?   @map("invoice_url")
  bankSlipUrl       String?   @map("bank_slip_url")
  deleted           Boolean   @default(false)
  lastEventAt       DateTime? @map("last_event_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, dueDate(sort: Desc)], map: "idx_subscription_payment_tenant_due")
  @@index([subscriptionId], map: "idx_subscription_payment_subscription")
  @@map("subscription_payment")
}

/// Sessão de checkout (cartão via Asaas Checkout; Pix/boleto registram a tentativa). ADR-0017
model SubscriptionCheckout {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  idempotencyKey     String    @map("idempotency_key")
  planId             String    @map("plan_id") @db.Uuid
  billingMethod      String    @map("billing_method")
  status             String    @default("PENDING")
  externalCheckoutId String?   @unique @map("external_checkout_id")
  url                String?
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey], map: "uq_subscription_checkout_idempotency")
  @@map("subscription_checkout")
}

/// Contadores de uso vs limites do plano.
model UsageCounter {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  metric    String
  period    String
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, metric, period], map: "usage_counter_tenant_metric_period_key")
  @@index([tenantId, metric], map: "idx_usage_counter_tenant")
  @@map("usage_counter")
}

/// DEK wrapped por tenant (envelope). Ver docs/07 §14.
model TenantCryptoKey {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  keyVersion  Int       @default(1) @map("key_version")
  algorithm   String    @default("AES-256-GCM")
  wrappedDek  String    @map("wrapped_dek")
  kekProvider String    @default("local_vps") @map("kek_provider")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, keyVersion])
  @@map("tenant_crypto_key")
}

/// Auditoria append-only (docs/07 / doc 17 / S8). Índice parcial `idx_audit_patient` na migração.
model AuditLog {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String   @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  patientId    String?  @map("patient_id") @db.Uuid
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_audit_tenant_time")
  @@map("audit_log")
}

/// Usuário global (sem RLS de tenant). docs/07 §2 · módulo identity
model User {
  id              String         @id @db.Uuid
  email           String         @unique @db.Citext
  passwordHash    String         @map("password_hash")
  name            String
  phone           String?
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz
  failedAttempts  Int            @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil     DateTime?      @map("locked_until") @db.Timestamptz
  platformRole    String?        @map("platform_role")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  memberships          Membership[]
  refreshTokens        RefreshToken[]
  invitationsSent      Invitation[]          @relation("InvitationInviter")
  passwordResetTokens  PasswordResetToken[]
  handledDataSubjectRequests DataSubjectRequest[] @relation("DsrHandler")

  @@map("user")
}

model Membership {
  id            String        @id @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  role          String
  defaultUnitId String?       @map("default_unit_id") @db.Uuid
  permissions   Json          @default("{}")
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  defaultUnit   Unit?         @relation(fields: [defaultUnitId], references: [id])
  professional   Professional?
  refreshTokens  RefreshToken[]

  @@unique([tenantId, userId])
  @@map("membership")
}

/// Convite de membro (token de uso único, 7 dias). DDL derivado de docs/modulos/01.
model Invitation {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.Citext
  role            String
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  invitedBy       User      @relation("InvitationInviter", fields: [invitedByUserId], references: [id])

  @@index([tenantId, email])
  @@map("invitation")
}

/// Refresh token opaco com família rotativa (sem RLS — escopo user). docs/modulos/01.
model RefreshToken {
  id           String      @id @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  membershipId String?     @map("membership_id") @db.Uuid
  familyId     String      @map("family_id") @db.Uuid
  tokenHash    String      @unique @map("token_hash")
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz
  revokedAt    DateTime?   @map("revoked_at") @db.Timestamptz
  replacedById String?     @map("replaced_by_id") @db.Uuid
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  user         User        @relation(fields: [userId], references: [id])
  membership   Membership? @relation(fields: [membershipId], references: [id])

  @@index([userId, familyId])
  @@map("refresh_token")
}

/// Token de reset de senha (uso único, 1h). Global, sem RLS de tenant. RF-E1-08.
model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_token")
}

model Unit {
  id           String                   @id @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  name         String
  isDefault    Boolean                  @default(false) @map("is_default")
  phone        String?
  address      Json?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  chairs       Chair[]
  memberships  Membership[]
  businessHours BusinessHours[]
  hoursExceptions BusinessHoursException[]
  patients     Patient[]
  appointments Appointment[]
  appointmentSeries AppointmentSeries[]
  scheduleBlocks ScheduleBlock[]
  waitlistEntries WaitlistEntry[]
  whatsappAccounts WhatsappAccount[]
  quotes          Quote[]
  receivables     Receivable[]
  productionEntries ProductionEntry[]
  payments        Payment[]
  payables        Payable[]
  cashSessions    CashSession[]

  @@map("unit")
}

model Chair {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  unitId    String  @map("unit_id") @db.Uuid
  name      String
  color     String?
  active    Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  unit      Unit    @relation(fields: [unitId], references: [id])
  appointments Appointment[]
  appointmentSeries AppointmentSeries[]
  scheduleBlocks ScheduleBlock[]

  @@map("chair")
}

model Professional {
  id           String                   @id @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  membershipId String                   @unique @map("membership_id") @db.Uuid
  croNumber    String?                  @map("cro_number")
  croState     String?                  @map("cro_state") @db.Char(2)
  specialties  String[]                 @default([])
  color        String?
  active       Boolean                  @default(true)
  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  membership   Membership               @relation(fields: [membershipId], references: [id])
  businessHours BusinessHours[]
  hoursExceptions BusinessHoursException[]
  appointments Appointment[]
  appointmentSeries AppointmentSeries[]
  scheduleBlocks ScheduleBlock[]
  waitlistEntries WaitlistEntry[]
  clinicalNotes ClinicalNote[]
  quotes          Quote[]
  treatmentItems  TreatmentItem[]
  productionEntries ProductionEntry[]

  @@unique([tenantId, membershipId])
  @@map("professional")
}

model BusinessHours {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  unitId         String        @map("unit_id") @db.Uuid
  professionalId String?       @map("professional_id") @db.Uuid
  /// ISO weekday: 1=Mon … 7=Sun
  weekday        Int           @db.SmallInt
  startsAt       DateTime      @map("starts_at") @db.Time(0)
  endsAt         DateTime      @map("ends_at") @db.Time(0)
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  unit           Unit          @relation(fields: [unitId], references: [id])
  professional   Professional? @relation(fields: [professionalId], references: [id])

  @@map("business_hours")
}

model BusinessHoursException {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  unitId         String        @map("unit_id") @db.Uuid
  professionalId String?       @map("professional_id") @db.Uuid
  date           DateTime      @db.Date
  closed         Boolean       @default(true)
  startsAt       DateTime?     @map("starts_at") @db.Time(0)
  endsAt         DateTime?     @map("ends_at") @db.Time(0)
  reason         String?
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  unit           Unit          @relation(fields: [unitId], references: [id])
  professional   Professional? @relation(fields: [professionalId], references: [id])

  @@map("business_hours_exception")
}

model Procedure {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  name            String
  specialty       String?
  defaultMinutes  Int      @default(30) @map("default_minutes") @db.SmallInt
  priceCents      BigInt   @default(0) @map("price_cents")
  requiresTooth   Boolean  @default(false) @map("requires_tooth")
  requiresFace    Boolean  @default(false) @map("requires_face")
  publiclyBookable Boolean @default(false) @map("publicly_bookable")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  appointments    Appointment[]
  appointmentSeries AppointmentSeries[]
  waitlistEntries WaitlistEntry[]
  quoteItems      QuoteItem[]
  treatmentItems  TreatmentItem[]
  productionEntries ProductionEntry[]

  @@unique([tenantId, code])
  @@map("procedure")
}

/// Contador de nº de ficha por tenant (RF-E3-13).
model PatientCodeCounter {
  tenantId String @id @map("tenant_id") @db.Uuid
  lastCode BigInt @default(0) @map("last_code")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("patient_code_counter")
}

/// Paciente. docs/07 §3 · RF E3
model Patient {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  unitId         String          @map("unit_id") @db.Uuid
  code           BigInt
  name           String
  socialName     String?         @map("social_name")
  cpf            String?         @db.Char(11)
  birthDate      DateTime?       @map("birth_date") @db.Date
  sex            String?
  phonePrimary   String          @map("phone_primary")
  phoneSecondary String?         @map("phone_secondary")
  email          String?         @db.Citext
  address        Json?
  howFoundUs     String?         @map("how_found_us")
  notes          String?
  photoKey       String?         @map("photo_key")
  origin         String          @default("INTERNAL")
  hasOverdue     Boolean         @default(false) @map("has_overdue")
  active         Boolean         @default(true)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  guardians      LegalGuardian[]
  consents       Consent[]
  appointments   Appointment[]
  appointmentSeries AppointmentSeries[]
  waitlistEntries WaitlistEntry[]
  conversations   Conversation[]
  medicalRecord   MedicalRecord?
  attachments     Attachment[]
  quotes          Quote[]
  treatmentPlans  TreatmentPlan[]
  receivables     Receivable[]
  productionEntries ProductionEntry[]
  creditLedger    PatientCreditLedger[]
  dataSubjectRequests DataSubjectRequest[]

  @@unique([tenantId, code], map: "uq_patient_tenant_code")
  @@index([tenantId, name], map: "idx_patient_name")
  @@index([tenantId, phonePrimary], map: "idx_patient_phone")
  @@map("patient")
}

model LegalGuardian {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  patientId    String  @map("patient_id") @db.Uuid
  name         String
  cpf          String? @db.Char(11)
  relationship String?
  phone        String?
  email        String? @db.Citext
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  patient      Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId], map: "idx_legal_guardian_patient")
  @@map("legal_guardian")
}

model Consent {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  type            String
  granted         Boolean
  documentVersion String    @map("document_version")
  channel         String
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  patient         Patient   @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, type], map: "idx_consent_patient")
  @@map("consent")
}

/// Série de recorrência (API completa no Bloco 3).
model AppointmentSeries {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  unitId           String        @map("unit_id") @db.Uuid
  patientId        String        @map("patient_id") @db.Uuid
  professionalId   String        @map("professional_id") @db.Uuid
  chairId          String?       @map("chair_id") @db.Uuid
  procedureId      String?       @map("procedure_id") @db.Uuid
  rrule            String
  startsAt         DateTime      @map("starts_at") @db.Timestamptz
  durationMinutes  Int           @map("duration_minutes") @db.SmallInt
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  unit             Unit          @relation(fields: [unitId], references: [id])
  patient          Patient       @relation(fields: [patientId], references: [id])
  professional     Professional  @relation(fields: [professionalId], references: [id])
  chair            Chair?        @relation(fields: [chairId], references: [id])
  procedure        Procedure?    @relation(fields: [procedureId], references: [id])
  appointments     Appointment[]

  @@map("appointment_series")
}

/// Agendamento. docs/07 §4 · EXCLUDE gist no SQL.
model Appointment {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  unitId          String              @map("unit_id") @db.Uuid
  patientId       String              @map("patient_id") @db.Uuid
  professionalId  String              @map("professional_id") @db.Uuid
  chairId         String?             @map("chair_id") @db.Uuid
  procedureId     String?             @map("procedure_id") @db.Uuid
  treatmentItemId String?             @map("treatment_item_id") @db.Uuid
  startsAt        DateTime            @map("starts_at") @db.Timestamptz
  endsAt          DateTime            @map("ends_at") @db.Timestamptz
  status          String              @default("SCHEDULED")
  origin          String              @default("INTERNAL")
  confirmedAt     DateTime?           @map("confirmed_at") @db.Timestamptz
  arrivedAt       DateTime?           @map("arrived_at") @db.Timestamptz
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz
  cancelReason    String?             @map("cancel_reason")
  recurrenceId    String?             @map("recurrence_id") @db.Uuid
  notes           String?
  idempotencyKey  String?             @map("idempotency_key")
  createdBy       String?             @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  unit            Unit                @relation(fields: [unitId], references: [id])
  patient         Patient             @relation(fields: [patientId], references: [id])
  professional    Professional        @relation(fields: [professionalId], references: [id])
  chair           Chair?              @relation(fields: [chairId], references: [id])
  procedure       Procedure?          @relation(fields: [procedureId], references: [id])
  series          AppointmentSeries?  @relation(fields: [recurrenceId], references: [id])
  history         AppointmentHistory[]

  @@index([tenantId, unitId, startsAt], map: "idx_appointment_agenda")
  @@index([tenantId, patientId, startsAt(sort: Desc)], map: "idx_appointment_patient")
  @@map("appointment")
}

model AppointmentHistory {
