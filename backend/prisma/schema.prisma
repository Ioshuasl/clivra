  tenantId        String    @map("tenant_id") @db.Uuid
  treatmentPlanId String    @map("treatment_plan_id") @db.Uuid
  procedureId     String    @map("procedure_id") @db.Uuid
  quoteItemId     String?   @map("quote_item_id") @db.Uuid
  toothCode       String?   @map("tooth_code")
  face            String?
  priceCents      BigInt    @map("price_cents")
  status          String    @default("PLANNED")
  professionalId  String?   @map("professional_id") @db.Uuid
  executedAt      DateTime? @map("executed_at") @db.Timestamptz
  clinicalNoteId  String?   @map("clinical_note_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  plan            TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])
  procedure       Procedure @relation(fields: [procedureId], references: [id])
  quoteItem       QuoteItem? @relation(fields: [quoteItemId], references: [id])
  professional    Professional? @relation(fields: [professionalId], references: [id])
  clinicalNote    ClinicalNote? @relation(fields: [clinicalNoteId], references: [id])
  productionEntries ProductionEntry[]

  @@index([tenantId, treatmentPlanId, status], map: "idx_treatment_item_status")
  @@map("treatment_item")
}

model FinancialCategory {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  kind     String
  parentId String? @map("parent_id") @db.Uuid
  active   Boolean @default(true)
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  parent   FinancialCategory?  @relation("FinancialCategoryTree", fields: [parentId], references: [id])
  children FinancialCategory[] @relation("FinancialCategoryTree")
  receivables Receivable[]
  payables    Payable[]

  @@unique([tenantId, name, kind])
  @@map("financial_category")
}

/// Título a receber. Fatia S5 — sem payment/caixa.
model Receivable {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  unitId           String   @map("unit_id") @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  quoteId          String?  @map("quote_id") @db.Uuid
  treatmentPlanId  String?  @map("treatment_plan_id") @db.Uuid
  totalCents       BigInt   @map("total_cents")
  installmentCount Int      @default(1) @map("installments") @db.SmallInt
  status           String   @default("OPEN")
  categoryId       String?  @map("category_id") @db.Uuid
  description      String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  unit             Unit     @relation(fields: [unitId], references: [id])
  patient          Patient  @relation(fields: [patientId], references: [id])
  quote            Quote?   @relation(fields: [quoteId], references: [id])
  treatmentPlan    TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  category         FinancialCategory? @relation(fields: [categoryId], references: [id])
  lines            Installment[]

  @@index([tenantId, patientId, status], map: "idx_receivable_patient")
  @@map("receivable")
}

model Installment {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  receivableId String    @map("receivable_id") @db.Uuid
  number       Int       @db.SmallInt
  dueDate      DateTime  @map("due_date") @db.Date
  amountCents  BigInt    @map("amount_cents")
  paidCents    BigInt    @default(0) @map("paid_cents")
  status       String    @default("OPEN")
  paidAt       DateTime? @map("paid_at") @db.Timestamptz
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([tenantId, receivableId, number])
  @@map("installment")
}

model ProductionEntry {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  unitId          String   @map("unit_id") @db.Uuid
  professionalId  String   @map("professional_id") @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  treatmentItemId String?  @map("treatment_item_id") @db.Uuid
  procedureId     String   @map("procedure_id") @db.Uuid
  amountCents     BigInt   @map("amount_cents")
  executedAt      DateTime @map("executed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  unit            Unit     @relation(fields: [unitId], references: [id])
  professional    Professional @relation(fields: [professionalId], references: [id])
  patient         Patient  @relation(fields: [patientId], references: [id])
  treatmentItem   TreatmentItem? @relation(fields: [treatmentItemId], references: [id])
  procedure       Procedure @relation(fields: [procedureId], references: [id])

  @@index([tenantId, professionalId, executedAt], map: "idx_production_period")
  @@map("production_entry")
}

/// Contador de nº de recibo por tenant (S6 — não IDENTITY global).
model ReceiptNumberCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber BigInt @default(0) @map("last_number")
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@map("receipt_number_counter")
}

/// Caixa do operador na unidade. Unique OPEN parcial está na migração SQL.
model CashSession {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  unitId            String    @map("unit_id") @db.Uuid
  openedBy          String    @map("opened_by") @db.Uuid
  openedAt          DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  openingCents      BigInt    @default(0) @map("opening_cents")
  openingByMethod   Json?     @map("opening_by_method")
  closedBy          String?   @map("closed_by") @db.Uuid
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  countedCents      BigInt?   @map("counted_cents")
  expectedCents     BigInt?   @map("expected_cents")
  differenceCents   BigInt?   @map("difference_cents")
  countedByMethod   Json?     @map("counted_by_method")
  expectedByMethod  Json?     @map("expected_by_method")
  differenceReason  String?   @map("difference_reason")
  status            String    @default("OPEN")
  idempotencyKey    String?   @map("idempotency_key")
  closeIdempotencyKey String? @map("close_idempotency_key")
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  unit              Unit      @relation(fields: [unitId], references: [id])
  payments          Payment[]
  movements         CashMovement[]

  @@map("cash_session")
}

/// Cabeçalho de recebimento. Splits em `payment_split`. Unique parcial de idempotency na migração SQL.
model Payment {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  unitId          String    @map("unit_id") @db.Uuid
  installmentId   String    @map("installment_id") @db.Uuid
  cashSessionId   String?   @map("cash_session_id") @db.Uuid
  amountCents     BigInt    @map("amount_cents")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  receivedBy      String    @map("received_by") @db.Uuid
  reversedAt      DateTime? @map("reversed_at") @db.Timestamptz
  reversalReason  String?   @map("reversal_reason")
  reversedBy      String?   @map("reversed_by") @db.Uuid
  receiptNumber   BigInt    @map("receipt_number")
  pdfStorageKey   String?   @map("pdf_storage_key")
  notes           String?
  idempotencyKey  String?   @map("idempotency_key")
  reversalIdempotencyKey String? @map("reversal_idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  unit            Unit      @relation(fields: [unitId], references: [id])
  installment     Installment @relation(fields: [installmentId], references: [id])
  cashSession     CashSession? @relation(fields: [cashSessionId], references: [id])
  splits          PaymentSplit[]
  creditLedger    PatientCreditLedger[]
  cashMovements   CashMovement[]

  @@unique([tenantId, receiptNumber], map: "uq_payment_receipt")
  @@index([tenantId, unitId, receivedAt], map: "idx_payment_period")
  @@index([tenantId, installmentId], map: "idx_payment_installment")
  @@map("payment")
}

model PaymentSplit {
  id              String  @id @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  paymentId       String  @map("payment_id") @db.Uuid
  method          String
  amountCents     BigInt  @map("amount_cents")
  cardBrand       String? @map("card_brand")
  installmentsQty Int?    @map("installments_qty") @db.SmallInt
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentId], map: "idx_payment_split_payment")
  @@map("payment_split")
}

/// Lançamentos com sinal. Saldo = SUM(amount_cents). Proibido campo saldo editável.
model PatientCreditLedger {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  paymentId   String?  @map("payment_id") @db.Uuid
  amountCents BigInt   @map("amount_cents")
  kind        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenantId, patientId, createdAt], map: "idx_patient_credit_ledger_patient")
  @@map("patient_credit_ledger")
}

model Payable {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  supplier    String?
  description String
  amountCents BigInt    @map("amount_cents")
  dueDate     DateTime  @map("due_date") @db.Date
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  paidCents   BigInt?   @map("paid_cents")
  method      String?
  recurrence  Json?
  status      String    @default("OPEN")
  payIdempotencyKey String? @map("pay_idempotency_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  unit        Unit      @relation(fields: [unitId], references: [id])
  category    FinancialCategory? @relation(fields: [categoryId], references: [id])

  @@index([tenantId, dueDate, status], map: "idx_payable_due")
  @@map("payable")
}

model CashMovement {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  cashSessionId String   @map("cash_session_id") @db.Uuid
  kind          String
  amountCents   BigInt   @map("amount_cents")
  method        String
  paymentId     String?  @map("payment_id") @db.Uuid
  description   String?
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  payment       Payment?    @relation(fields: [paymentId], references: [id])

  @@index([tenantId, cashSessionId, createdAt], map: "idx_cash_movement_session")
  @@map("cash_movement")
}

/// Export assíncrono de relatório (E9). docs/07 · S7 Bloco 4
model ReportExport {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  report      String
  format      String
  status      String    @default("PENDING")
  filters     Json      @default("{}")
  storageKey  String?   @map("storage_key")
  requestedBy String    @map("requested_by") @db.Uuid
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_report_export_tenant_created")
  @@index([tenantId, status], map: "idx_report_export_tenant_status")
  @@map("report_export")
}

/// Solicitação do titular (LGPD). docs/07 · S8
model DataSubjectRequest {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  type        String
  status      String    @default("RECEIVED")
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  dueAt       DateTime  @map("due_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  handledBy   String?   @map("handled_by") @db.Uuid
  resolution  String?
  exportKey   String?   @map("export_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  patient     Patient   @relation(fields: [patientId], references: [id])
  handler     User?     @relation("DsrHandler", fields: [handledBy], references: [id])

  @@index([tenantId, requestedAt(sort: Desc)], map: "idx_dsr_tenant_requested")
  @@index([tenantId, dueAt], map: "idx_dsr_tenant_due")
  @@map("data_subject_request")
}
