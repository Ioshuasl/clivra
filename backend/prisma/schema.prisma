  messages               Message[]

  @@unique([tenantId, whatsappAccountId, contactPhone], map: "uq_conversation_contact")
  @@index([tenantId, status, lastMessageAt(sort: Desc)], map: "idx_conversation_inbox")
  @@map("conversation")
}

model Message {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  direction         String
  type              String
  templateId        String?   @map("template_id") @db.Uuid
  body              String?
  mediaKey          String?   @map("media_key")
  providerMessageId String?   @map("provider_message_id")
