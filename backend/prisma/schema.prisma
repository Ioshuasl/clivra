  lastNumber BigInt @default(0) @map("last_number")
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@map("quote_number_counter")
}

/// Orçamento. docs/07 §6 · S5
model Quote {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  unitId           String    @map("unit_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  professionalId   String    @map("professional_id") @db.Uuid
  number           BigInt
  status           String    @default("DRAFT")
  subtotalCents    BigInt    @default(0) @map("subtotal_cents")
  discountCents    BigInt    @default(0) @map("discount_cents")
  totalCents       BigInt    @default(0) @map("total_cents")
  validUntil       DateTime? @map("valid_until") @db.Date
  notes            String?
  sentAt           DateTime? @map("sent_at") @db.Timestamptz
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz
  decidedBy        String?   @map("decided_by")
  rejectReason     String?   @map("reject_reason")
  pdfStorageKey    String?   @map("pdf_storage_key")
  idempotencyKey   String?   @map("idempotency_key")
  duplicatedFromId String?   @map("duplicated_from_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  unit             Unit      @relation(fields: [unitId], references: [id])
  patient          Patient   @relation(fields: [patientId], references: [id])
  professional     Professional @relation(fields: [professionalId], references: [id])
  duplicatedFrom   Quote?    @relation("QuoteDuplicate", fields: [duplicatedFromId], references: [id])
  duplicates       Quote[]   @relation("QuoteDuplicate")
  items            QuoteItem[]
  treatmentPlans   TreatmentPlan[]
  receivables      Receivable[]

  @@unique([tenantId, number], map: "uq_quote_tenant_number")
  @@index([tenantId, patientId, createdAt(sort: Desc)], map: "idx_quote_patient")
  @@map("quote")
}

model QuoteItem {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  quoteId        String  @map("quote_id") @db.Uuid
  procedureId    String  @map("procedure_id") @db.Uuid
  toothCode      String? @map("tooth_code")
  face           String?
  quantity       Int     @default(1) @db.SmallInt
  unitPriceCents BigInt  @map("unit_price_cents")
  discountCents  BigInt  @default(0) @map("discount_cents")
  totalCents     BigInt  @map("total_cents")
  approved       Boolean @default(true)
  sortOrder      Int     @default(0) @map("sort_order") @db.SmallInt
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  procedure      Procedure @relation(fields: [procedureId], references: [id])
  treatmentItems TreatmentItem[]

  @@index([tenantId, quoteId, sortOrder], map: "idx_quote_item_quote")
  @@map("quote_item")
}

model TreatmentPlan {
