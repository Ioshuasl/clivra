{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node ./scripts/prisma-generate-safe.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --config ../eslint.config.mjs",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "echo \"no tests yet\"",
    "test:kms": "tsx scripts/check-kms.ts",
    "test:clinical-crypto": "tsx scripts/check-clinical-crypto.ts",
    "test:rls": "tsx scripts/check-rls.ts",
    "test:identity": "tsx scripts/smoke-identity.ts",
    "test:clinic": "tsx scripts/smoke-clinic.ts",
    "test:patients": "tsx scripts/smoke-patients.ts",
    "test:scheduling": "tsx scripts/smoke-scheduling.ts",
    "test:outbox": "tsx scripts/smoke-outbox.ts",
    "test:public-booking": "tsx scripts/smoke-public-booking.ts",
    "test:waitlist": "tsx scripts/smoke-waitlist.ts",
    "test:messaging": "tsx scripts/smoke-messaging.ts",
    "test:messaging-inbox": "tsx scripts/smoke-messaging-inbox.ts",
    "test:anamnesis": "tsx scripts/smoke-anamnesis.ts",
    "test:odontogram": "tsx scripts/smoke-odontogram.ts",
    "test:clinical-notes": "tsx scripts/smoke-clinical-notes.ts",
    "test:attachments": "tsx scripts/smoke-attachments.ts",
    "test:split-installments": "tsx scripts/check-split-installments.ts",
    "test:receipt-amount-in-words": "tsx scripts/check-receipt-amount-in-words.ts",
    "test:quotes-crud": "tsx scripts/smoke-quotes-crud.ts",
    "test:quotes-send": "tsx scripts/smoke-quotes-send.ts",
    "test:quotes-decision": "tsx scripts/smoke-quotes-decision.ts",
    "test:treatments-execute": "tsx scripts/smoke-treatments-execute.ts",
    "test:billing-payments": "tsx scripts/smoke-billing-payments.ts",
    "test:billing-cash": "tsx scripts/smoke-billing-cash.ts",
    "test:billing-payables": "tsx scripts/smoke-billing-payables.ts",
    "test:billing-reports": "tsx scripts/smoke-billing-reports.ts",
    "test:reporting-dashboard": "tsx scripts/smoke-reporting-dashboard.ts",
    "test:reporting-export": "tsx scripts/smoke-reporting-export.ts",
    "test:subscription": "tsx scripts/smoke-subscription.ts",
    "test:asaas-adapter": "tsx scripts/smoke-asaas-adapter.ts",
    "test:subscription-checkout": "tsx scripts/smoke-subscription-checkout.ts",
    "test:asaas-webhook": "tsx scripts/smoke-asaas-webhook.ts",
    "accept": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/Invoke-Acceptance.ps1",
    "accept:billing": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/billing/Run-S6.ps1",
    "accept:identity": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tests/Invoke-Acceptance.ps1 -Module identity",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate-deploy.ts",
    "db:seed": "tsx prisma/seeders/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@prisma/client": "^6.5.0",
    "@repo/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^14.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^11.0.0",
    "dependency-cruiser": "^16.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
